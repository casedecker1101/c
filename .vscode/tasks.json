{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build active C++ file",
            "type": "shell",
            "command": "C:\\Users\\flynn\\AppData\\Local\\Microsoft\\WinGet\\Packages\\BrechtSanders.WinLibs.MCF.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe\\mingw64\\bin\\g++.exe",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lgdi32"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build active C++ file (MSVC)",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/nologo",
                "/Zi",
                "/EHsc",
                "${file}",
                "/Fe:${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "build active C++ file (selected compiler)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-Command",
                "if ('${input:cppCompiler}' -eq 'g++') { & 'C:\\Users\\flynn\\AppData\\Local\\Microsoft\\WinGet\\Packages\\BrechtSanders.WinLibs.MCF.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe\\mingw64\\bin\\g++.exe' -g '${file}' -o '${fileDirname}\\${fileBasenameNoExtension}.exe' -lgdi32 } elseif ('${input:cppCompiler}' -eq 'MSVC (cl.exe)') { & cl.exe /nologo /Zi /EHsc '${file}' '/Fe:${fileDirname}\\${fileBasenameNoExtension}.exe' } else { throw 'Unsupported compiler selection.' }"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/Users/flynn/AppData/Local/Microsoft/WinGet/Packages/BrechtSanders.WinLibs.MCF.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lgdi32"
            ],
            "options": {
                "cwd": "C:/Users/flynn/AppData/Local/Microsoft/WinGet/Packages/BrechtSanders.WinLibs.MCF.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/mingw64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "inputs": [
        {
            "id": "cppCompiler",
            "type": "pickString",
            "description": "Choose compiler for this build",
            "options": [
                "g++",
                "MSVC (cl.exe)"
            ],
            "default": "g++"
        }
    ]
}